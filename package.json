{
  "name": "pharos-multi-protocol-aggregator",
  "version": "1.0.0",
  "description": "Production-quality Multi-Protocol Aggregator on Pharos: Harbor-style agent across multiple protocols and vaults with explainable venue routing, portfolio inspection, and fault isolation.",
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types src/build.ts",
    "bundle:api": "esbuild src/api/*.ts --bundle --platform=node --format=esm --target=node20 --outdir=api",
    "test": "node --dns-result-order=ipv4first --test --test-concurrency=1 --experimental-strip-types tests/unit/*.test.ts",
    "test:integration": "node --dns-result-order=ipv4first --test --test-concurrency=1 --experimental-strip-types tests/integration/*.test.ts",
    "test:all": "node --dns-result-order=ipv4first --test --test-concurrency=1 --experimental-strip-types tests/**/*.test.ts",
    "start": "node --dns-result-order=ipv4first --experimental-strip-types src/server.ts"
  },
  "keywords": [
    "pharos",
    "pharos-agent-arena",
    "multi-protocol-aggregator",
    "faroo",
    "stpros",
    "wpros",
    "erc-4626",
    "non-custodial",
    "typescript"
  ],
  "author": "JimmyOgb",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
